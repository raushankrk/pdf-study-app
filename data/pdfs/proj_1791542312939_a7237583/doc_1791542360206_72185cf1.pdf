<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF Linker Studio (AI + SQLite Storage)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- PDF.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <!-- PDF-Lib (For Editing) -->
    <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
    <!-- SQL.js (For Project Storage) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/sql-wasm.js"></script>
    <!-- FileSaver.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/style.css">
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>

    <!-- KaTeX for math -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js"></script>

    <!-- Highlight.js for code blocks -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>    
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        const { PDFDocument } = PDFLib;
    </script>
</head>
<body class="bg-gray-100 h-screen flex flex-col overflow-hidden text-gray-800 font-sans">

    <!-- Header -->
    <header class="bg-white border-b border-gray-200 h-14 flex items-center justify-between px-4 shrink-0 z-20 shadow-sm">
        
        <!-- Left: Brand -->
        <div class="flex items-center gap-3">
            <button onclick="toggleLeftSidebar()" class="toggle-left-btn w-8 h-8 rounded hover:bg-gray-100 text-gray-500 transition-all" title="Toggle Sidebar (Ctrl+B)">
                <i class="fa-solid fa-bars"></i>
            </button>
            <i class="fa-solid fa-file-pdf text-red-500 text-xl"></i>
            <h1 class="text-base font-bold text-gray-800">PDF Linker Studio</h1>
        </div>

        <!-- Center: All Tools -->
        <div class="flex items-center gap-1">

            <!-- Group 1: App Modes -->
            <div class="flex items-center bg-gray-100 rounded-lg p-1 gap-0.5">
                <button id="mode-nav-btn" onclick="setAppMode('navigation')"
                    class="tool-btn active-mode"
                    title="Navigate (V)">
                    <i class="fa-solid fa-arrow-pointer"></i>
                </button>
                <button id="mode-link-btn" onclick="setAppMode('linking')"
                    class="tool-btn"
                    title="Draw Link (L)">
                    <i class="fa-solid fa-link"></i>
                </button>
                <button id="mode-snip-link-btn" onclick="setAppMode('snip-link')"
                    class="tool-btn"
                    title="Snip & Link (S)">
                    <i class="fa-solid fa-scissors"></i>
                </button>
                <button id="mode-del-link-btn" onclick="setAppMode('delete-link')"
                    class="tool-btn"
                    title="Delete Link (X)">
                    <i class="fa-solid fa-link-slash"></i>
                </button>
            </div>

            <div class="w-px h-6 bg-gray-300 mx-1"></div>

            <!-- Group 2: Annotation Draw Tools -->
            <div class="flex items-center bg-gray-100 rounded-lg p-1 gap-0.5">
                <button id="tool-select" onclick="setAnnoTool('select')"
                    class="tool-btn"
                    title="Select (Ctrl+S)">
                    <i class="fa-solid fa-object-group"></i>
                </button>
                <button id="tool-pen" onclick="setAnnoTool('pen')"
                    class="tool-btn"
                    title="Pen (P)">
                    <i class="fa-solid fa-pen-nib"></i>
                </button>
                <button id="tool-highlighter" onclick="setAnnoTool('highlighter')"
                    class="tool-btn"
                    title="Highlighter (H)">
                    <i class="fa-solid fa-highlighter"></i>
                </button>
                <button id="tool-text" onclick="setAnnoTool('text')"
                    class="tool-btn"
                    title="Text Box (T)">
                    <i class="fa-solid fa-font"></i>
                </button>
                <button id="tool-eraser-pixel" onclick="setAnnoTool('eraser-pixel')"
                    class="tool-btn"
                    title="Pixel Eraser (E)">
                    <i class="fa-solid fa-eraser"></i>
                </button>
                <button id="tool-eraser-stroke" onclick="setAnnoTool('eraser-stroke')"
                    class="tool-btn"
                    title="Stroke Eraser (D)">
                    <i class="fa-solid fa-ban"></i>
                </button>
                <button id="tool-image" onclick="setAnnoTool('image')"
                    class="tool-btn"
                    title="Add Image (I)">
                    <i class="fa-regular fa-image"></i>
                </button>
                <input type="file" id="image-upload" class="hidden" accept="image/*">
            </div>

            <div class="w-px h-6 bg-gray-300 mx-1"></div>

            <!-- Group 3: Pen/Highlighter Options (shown only when pen/highlighter active) -->
            <div id="pen-customization" class="hidden items-center bg-gray-100 rounded-lg p-1 gap-1">
                <!-- Straight/Freehand toggle -->
                <button id="tool-line-mode" onclick="toggleLineMode()"
                    class="tool-btn"
                    title="Freehand / Straight Line (F)">
                    <i class="fa-solid fa-minus"></i>
                </button>
                <div class="w-px h-5 bg-gray-300 mx-0.5"></div>
                <!-- Thickness slider -->
                <input type="range" id="thickness-picker" min="1" max="20" value="5"
                    class="w-20 h-1 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600 mx-1">
                <!-- Color + size preview canvas (click to pick color) -->
                <canvas id="thickness-preview-canvas" width="32" height="32"
                    class="rounded cursor-pointer"
                    title="Click to change color"></canvas>
                <input type="color" id="color-picker" class="hidden" value="#ef4444">
            </div>

            <!-- Group 3 separator: only visible when pen-customization is showing -->
            <div id="pen-customization-sep" class="hidden w-px h-6 bg-gray-300 mx-1"></div>

            <!-- Group 4: Actions -->
            <div class="flex items-center bg-gray-100 rounded-lg p-1 gap-0.5">
                <button onclick="undoLastStroke()"
                    class="tool-btn"
                    title="Undo (Ctrl+Z)">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
                <button onclick="deleteSelection()"
                    class="tool-btn text-red-400 hover:text-red-600 hover:bg-red-50"
                    title="Delete Selection (Del)">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
                <button onclick="clearCurrentPageAnnotations()"
                    class="tool-btn text-red-400 hover:text-red-600 hover:bg-red-50"
                    title="Clear Page Annotations">
                    <i class="fa-solid fa-file-circle-xmark"></i>
                </button>
            </div>

        </div>

        <!-- Right: Save / Open / AI -->
        <div class="flex items-center gap-2">
            <button onclick="exportProject()"
                class="flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-3 py-1.5 rounded-lg shadow-sm transition-colors"
                title="Save Project (Ctrl+Shift+S)">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
            <label class="flex items-center gap-1.5 text-gray-600 hover:text-blue-600 text-sm font-medium px-3 py-1.5 rounded-lg border border-gray-200 hover:border-blue-300 bg-white cursor-pointer transition-colors"
                title="Open Project">
                <i class="fa-solid fa-folder-open"></i>
                <span>Open</span>
                <input type="file" id="import-project-input" class="hidden" accept=".sqlite">
            </label>
            <div class="w-px h-6 bg-gray-300"></div>
            <button onclick="toggleAiSidebar()"
                class="toggle-ai-btn flex items-center gap-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 border border-indigo-200 text-sm font-medium px-3 py-1.5 rounded-lg transition-colors"
                title="Toggle AI Panel (Ctrl+/)">
                <i class="fa-solid fa-robot"></i>
                <span>AI</span>
            </button>
        </div>

    </header>

    <!-- Main Content -->
    <div class="flex flex-1 overflow-hidden">

        <!-- Left Sidebar (Unified Explorer Tree) -->
        <aside id="left-sidebar" class="bg-white border-r border-gray-200 flex flex-col shrink-0 z-10 w-72">
            <!-- Top row: quick actions -->
            <div class="px-2 pt-2 pb-1.5 flex items-center gap-1 border-b border-gray-100">
                <button onclick="promptForNewFolder(state.currentFolderId || 'root')" class="w-7 h-7 rounded hover:bg-blue-50 text-blue-600 transition-colors flex items-center justify-center" title="New folder (Ctrl+Shift+N)">
                    <i class="fa-solid fa-folder-plus text-xs"></i>
                </button>
                <label class="w-7 h-7 rounded hover:bg-blue-50 text-blue-600 transition-colors flex items-center justify-center cursor-pointer" title="Import PDFs into current folder">
                    <i class="fa-solid fa-file-arrow-up text-xs"></i>
                    <input type="file" id="pdf-upload-input" class="hidden" accept=".pdf" multiple>
                </label>
                <button onclick="toggleSortMenu()" class="w-7 h-7 rounded hover:bg-gray-100 text-gray-500 transition-colors flex items-center justify-center" title="Sort options">
                    <i class="fa-solid fa-arrow-down-wide-short text-xs"></i>
                </button>
                <button onclick="state.currentFolderId = 'root'; state.fileSelection.docIds.clear(); state.fileSelection.folderIds.clear(); saveSettings(); renderDocList();" class="w-7 h-7 rounded hover:bg-gray-100 text-gray-500 transition-colors flex items-center justify-center" title="Go to root">
                    <i class="fa-solid fa-house text-xs"></i>
                </button>
                <span id="file-count-label" class="ml-auto text-[10px] text-gray-400 pr-1"></span>

                <!-- Sort dropdown (hidden by default) -->
                <div id="sort-dropdown" class="hidden absolute mt-9 ml-12 bg-white shadow-lg border border-gray-200 rounded-md py-1 z-50 w-32 text-xs">
                    <div class="px-2 py-1 text-[10px] text-gray-400 uppercase">Sort by</div>
                    <button class="sort-menu-item block w-full text-left px-3 py-1.5 hover:bg-blue-50" onclick="setSortBy('name')">Name <span id="sort-name-arrow" class="float-right"></span></button>
                    <button class="sort-menu-item block w-full text-left px-3 py-1.5 hover:bg-blue-50" onclick="setSortBy('date')">Date <span id="sort-date-arrow" class="float-right"></span></button>
                    <button class="sort-menu-item block w-full text-left px-3 py-1.5 hover:bg-blue-50" onclick="setSortBy('size')">Size <span id="sort-size-arrow" class="float-right"></span></button>
                    <button class="sort-menu-item block w-full text-left px-3 py-1.5 hover:bg-blue-50" onclick="setSortBy('type')">Type <span id="sort-type-arrow" class="float-right"></span></button>
                </div>
            </div>

            <!-- Unified search with toggle (Files <-> Content) -->
            <div class="px-2 py-2 border-b border-gray-100">
                <div class="relative">
                    <input type="text" id="unified-search-input" placeholder="Search files..." class="w-full pl-7 pr-12 py-1.5 text-xs border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <i id="unified-search-icon" class="fa-solid fa-filter absolute left-2.5 top-2 text-gray-400 text-[10px]"></i>
                    <!-- Toggle button: switch between Files filter and Content search -->
                    <button id="search-mode-toggle" onclick="toggleSearchMode()" class="absolute right-1 top-1/2 -translate-y-1/2 flex items-center gap-0.5 px-1.5 py-0.5 text-[9px] font-bold rounded bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors" title="Toggle search mode (Files / Content)">
                        <span id="search-mode-label">FILES</span>
                    </button>
                </div>
                <!-- Content-search results dropdown (only shown when in Content mode) -->
                <div id="global-search-results" class="mt-2 max-h-44 overflow-y-auto hidden bg-white border border-gray-200 rounded shadow-sm"></div>
            </div>

            <!-- Unified Explorer Tree (folders + files, with connector lines) -->
            <div id="doc-list" class="flex-1 overflow-y-auto relative explorer-tree-container">
                <div id="explorer-tree" class="py-1"></div>
                <div id="loading-spinner" class="hidden flex flex-col items-center justify-center mt-10 absolute inset-0 bg-white/80">
                    <div class="spinner mb-2"></div>
                    <span class="text-xs text-gray-500">Processing...</span>
                </div>
                <div class="text-center mt-10 text-gray-400 text-sm italic" id="empty-state-msg">
                    No PDFs imported yet.
                </div>
            </div>

            <!-- Bulk action bar (shown when files are selected) -->
            <div id="bulk-action-bar" class="hidden border-t border-gray-200 bg-blue-50/50 px-3 py-2 flex items-center gap-2 text-xs">
                <span id="bulk-selection-count" class="text-blue-700 font-medium"></span>
                <button class="ml-auto text-blue-600 hover:underline" onclick="showMoveDialog(Array.from(state.fileSelection.docIds), Array.from(state.fileSelection.folderIds))" title="Move selected">Move</button>
                <button class="text-blue-600 hover:underline" onclick="copySelectedFiles()" title="Copy selected (Ctrl+C)">Copy</button>
                <button class="text-blue-600 hover:underline" onclick="pasteClipboardFiles()" title="Paste (Ctrl+V)">Paste</button>
                <button class="text-red-600 hover:underline" onclick="showBulkDeleteDialog()" title="Delete selected (Del)">Delete</button>
                <button class="text-gray-500 hover:underline" onclick="clearFileSelection()" title="Clear selection (Esc)">Cancel</button>
            </div>

            <div class="p-2 bg-gray-50 border-t border-gray-200">
                <button onclick="clearAllData()" class="w-full py-1.5 text-xs font-bold text-red-600 border border-red-200 rounded bg-red-50 hover:bg-red-100 transition-colors">
                    <i class="fa-solid fa-trash mr-1"></i> Clear All Data
                </button>
            </div>
        </aside>

        <!-- Workspace (Split View) -->
        <main class="flex-1 flex bg-gray-200 overflow-hidden relative" id="workspace-main">
            
            <!-- Left Viewport -->
            <div id="left-panel" class="flex flex-col border-r border-gray-300 relative min-w-0 group" style="width: 50%;">
                <div class="h-10 bg-white border-b border-gray-300 flex items-center justify-between px-4 shrink-0 z-10">
                    <div class="flex items-center gap-2">

                    <button id="lock-left-btn" onclick="toggleLock('left')" class="lock-btn" title="Lock Left Viewport">
                        <i class="fa-solid fa-lock-open"></i>
                    </button>

                        <span class="text-sm font-bold text-gray-600 truncate w-24" id="left-view-title">None</span>
                        <div class="relative group/search">
                            <input type="text" id="left-search-input" placeholder="Find..." class="hidden pl-6 pr-2 py-0.5 text-[10px] border border-gray-300 rounded w-24 focus:w-32 transition-all focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <button id="left-search-toggle" onclick="toggleViewportSearch('left')" class="w-6 h-6 rounded hover:bg-gray-100 flex items-center justify-center text-gray-500 text-xs">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                            <div id="left-search-nav" class="hidden absolute right-0 top-6 bg-white shadow-md border rounded flex p-1 z-50">
                                <button onclick="navigateSearchResult('left', -1)" class="p-1 hover:bg-gray-100 rounded text-gray-600 text-xs"><i class="fa-solid fa-chevron-up"></i></button>
                                <span id="left-search-count" class="text-[10px] self-center px-1 text-gray-500">0/0</span>
                                <button onclick="navigateSearchResult('left', 1)" class="p-1 hover:bg-gray-100 rounded text-gray-600 text-xs"><i class="fa-solid fa-chevron-down"></i></button>
                                <button onclick="closeViewportSearch('left')" class="ml-1 p-1 hover:bg-red-50 text-red-500 rounded text-xs"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="flex items-center bg-gray-50 rounded border border-gray-200">
                            <button onclick="zoomViewport('left', -0.25)" class="px-1.5 py-0.5 hover:bg-gray-200 rounded text-gray-600 text-xs"><i class="fa-solid fa-minus"></i></button>
                            <span id="left-zoom-level" class="text-[10px] w-8 text-center font-mono text-gray-500">100%</span>
                            <button onclick="zoomViewport('left', 0.25)" class="px-1.5 py-0.5 hover:bg-gray-200 rounded text-gray-600 text-xs"><i class="fa-solid fa-plus"></i></button>
                            <div class="w-px h-3 bg-gray-300 mx-0.5"></div>
                            <button onclick="resetZoom('left')" class="px-1.5 py-0.5 hover:bg-blue-100 text-blue-600 rounded text-xs" title="Fit Width"><i class="fa-solid fa-expand"></i></button>
                        </div>

                        <div class="w-px h-4 bg-gray-300 mx-1"></div>

                        <button onclick="navigatePage('left', -1)" class="p-1 hover:bg-gray-100 rounded text-gray-600"><i class="fa-solid fa-chevron-left"></i></button>
                        <div class="flex items-center justify-center w-20 text-xs text-gray-500 font-mono">
                            <input type="number" id="left-page-input" class="w-8 text-center border border-transparent hover:border-gray-300 focus:border-blue-500 rounded bg-transparent p-0 outline-none hide-arrows transition-colors" value="" placeholder="-" onchange="jumpToPage('left')" onkeydown="if(event.key==='Enter') this.blur();" title="Jump to page">
                            <span class="mx-1">/</span>
                            <span id="left-page-total" class="w-8 text-left">--</span>
                        </div>
                        <button onclick="navigatePage('left', 1)" class="p-1 hover:bg-gray-100 rounded text-gray-600"><i class="fa-solid fa-chevron-right"></i></button>
                        
                        <div class="w-px h-4 bg-gray-300 mx-1"></div>

                        <button onclick="insertPage('left', 'blank')" class="p-1 hover:text-indigo-600 hover:bg-indigo-50 text-gray-400 rounded transition-colors" title="Insert Blank Page After Current"><i class="fa-regular fa-file-circle-plus text-sm"></i></button>
                        <button onclick="insertPage('left', 'duplicate')" class="p-1 hover:text-indigo-600 hover:bg-indigo-50 text-gray-400 rounded transition-colors" title="Duplicate Current Page"><i class="fa-regular fa-clone text-sm"></i></button>
                        <button onclick="deleteCurrentPage('left')" class="p-1 hover:text-red-600 hover:bg-red-50 text-gray-400 rounded transition-colors" title="Delete Current Page"><i class="fa-solid fa-trash-can text-sm"></i></button>
                    </div>
                </div>
                
                <!-- Left Horizontal Page Slider -->
                <div class="w-full shrink-0 bg-gray-200 relative z-[110] border-b border-gray-300" style="height: 4px;">
                    <input type="range" id="left-page-slider" min="1" max="1" value="1" class="page-slider hidden" oninput="syncPageInput('left')" onchange="jumpToPageFromSlider('left')" title="Scroll through pages">
                </div>

                <div class="flex-1 overflow-auto relative p-4 bg-gray-500/10 pdf-canvas-container" id="left-viewport">
                    <div id="left-canvas-wrapper" class="relative shadow-lg mx-auto">
                        <canvas id="left-canvas" class="pdf-canvas bg-white block"></canvas>
                        <div id="left-text-layer" class="textLayer"></div>
                        <div id="left-search-layer" class="search-highlight-layer"></div>
                        <canvas id="left-anno-canvas" class="annotation-canvas"></canvas>
                        <div id="left-markers-layer" class="absolute inset-0 pointer-events-none"></div>
                    </div>
                </div>
            </div>

            <!-- Vertical Resizer -->
            <div id="vertical-resizer" title="Drag to resize viewports"></div>

            <!-- Right Viewport -->
            <div id="right-panel" class="flex flex-col relative min-w-0" style="width: 50%;">
                <div class="h-10 bg-white border-b border-gray-300 flex items-center justify-between px-4 shrink-0 z-10">
                    <div class="flex items-center gap-2">

                    <button id="lock-right-btn" onclick="toggleLock('right')" class="lock-btn" title="Lock Right Viewport">
                        <i class="fa-solid fa-lock-open"></i>
                    </button>

                        <span class="text-sm font-bold text-gray-600 truncate w-24" id="right-view-title">None</span>
                        <div class="relative group/search">
                            <input type="text" id="right-search-input" placeholder="Find..." class="hidden pl-6 pr-2 py-0.5 text-[10px] border border-gray-300 rounded w-24 focus:w-32 transition-all focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <button id="right-search-toggle" onclick="toggleViewportSearch('right')" class="w-6 h-6 rounded hover:bg-gray-100 flex items-center justify-center text-gray-500 text-xs">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                            <div id="right-search-nav" class="hidden absolute right-0 top-6 bg-white shadow-md border rounded flex p-1 z-50">
                                <button onclick="navigateSearchResult('right', -1)" class="p-1 hover:bg-gray-100 rounded text-gray-600 text-xs"><i class="fa-solid fa-chevron-up"></i></button>
                                <span id="right-search-count" class="text-[10px] self-center px-1 text-gray-500">0/0</span>
                                <button onclick="navigateSearchResult('right', 1)" class="p-1 hover:bg-gray-100 rounded text-gray-600 text-xs"><i class="fa-solid fa-chevron-down"></i></button>
                                <button onclick="closeViewportSearch('right')" class="ml-1 p-1 hover:bg-red-50 text-red-500 rounded text-xs"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-2">
                         <div class="flex items-center bg-gray-50 rounded border border-gray-200">
                            <button onclick="zoomViewport('right', -0.25)" class="px-1.5 py-0.5 hover:bg-gray-200 rounded text-gray-600 text-xs"><i class="fa-solid fa-minus"></i></button>
                            <span id="right-zoom-level" class="text-[10px] w-8 text-center font-mono text-gray-500">100%</span>
                            <button onclick="zoomViewport('right', 0.25)" class="px-1.5 py-0.5 hover:bg-gray-200 rounded text-gray-600 text-xs"><i class="fa-solid fa-plus"></i></button>
                            <div class="w-px h-3 bg-gray-300 mx-0.5"></div>
                            <button onclick="resetZoom('right')" class="px-1.5 py-0.5 hover:bg-blue-100 text-blue-600 rounded text-xs" title="Fit Width"><i class="fa-solid fa-expand"></i></button>
                        </div>

                        <div class="w-px h-4 bg-gray-300 mx-1"></div>

                        <button onclick="navigatePage('right', -1)" class="p-1 hover:bg-gray-100 rounded text-gray-600"><i class="fa-solid fa-chevron-left"></i></button>
                        <div class="flex items-center justify-center w-20 text-xs text-gray-500 font-mono">
                            <input type="number" id="right-page-input" class="w-8 text-center border border-transparent hover:border-gray-300 focus:border-blue-500 rounded bg-transparent p-0 outline-none hide-arrows transition-colors" value="" placeholder="-" onchange="jumpToPage('right')" onkeydown="if(event.key==='Enter') this.blur();" title="Jump to page">
                            <span class="mx-1">/</span>
                            <span id="right-page-total" class="w-8 text-left">--</span>
                        </div>
                        <button onclick="navigatePage('right', 1)" class="p-1 hover:bg-gray-100 rounded text-gray-600"><i class="fa-solid fa-chevron-right"></i></button>
                        
                        <div class="w-px h-4 bg-gray-300 mx-1"></div>

                        <button onclick="insertPage('right', 'blank')" class="p-1 hover:text-indigo-600 hover:bg-indigo-50 text-gray-400 rounded transition-colors" title="Insert Blank Page After Current"><i class="fa-regular fa-file-circle-plus text-sm"></i></button>
                        <button onclick="insertPage('right', 'duplicate')" class="p-1 hover:text-indigo-600 hover:bg-indigo-50 text-gray-400 rounded transition-colors" title="Duplicate Current Page"><i class="fa-regular fa-clone text-sm"></i></button>
                        <button onclick="deleteCurrentPage('right')" class="p-1 hover:text-red-600 hover:bg-red-50 text-gray-400 rounded transition-colors" title="Delete Current Page"><i class="fa-solid fa-trash-can text-sm"></i></button>
                    </div>
                </div>
                
                <!-- Right Horizontal Page Slider -->
                <div class="w-full shrink-0 bg-gray-200 relative z-[110] border-b border-gray-300" style="height: 4px;">
                    <input type="range" id="right-page-slider" min="1" max="1" value="1" class="page-slider hidden" oninput="syncPageInput('right')" onchange="jumpToPageFromSlider('right')" title="Scroll through pages">
                </div>

                <div class="flex-1 overflow-auto relative p-4 bg-gray-500/10 pdf-canvas-container" id="right-viewport">
                    <div id="right-canvas-wrapper" class="relative shadow-lg mx-auto">
                        <canvas id="right-canvas" class="pdf-canvas bg-white block"></canvas>
                        <div id="right-text-layer" class="textLayer"></div>
                        <div id="right-search-layer" class="search-highlight-layer"></div>
                        <canvas id="right-anno-canvas" class="annotation-canvas"></canvas>
                        <div id="right-markers-layer" class="absolute inset-0 pointer-events-none"></div>
                    </div>
                </div>
            </div>

            <svg id="drawing-layer" class="absolute inset-0 w-full h-full z-40 overflow-visible pointer-events-none">
                <path id="current-draw-path" d="" fill="none" stroke="#ef4444" stroke-width="2" stroke-dasharray="5,5" style="display:none;"></path>
                <div id="text-creation-rect" style="display:none; position:absolute; border: 1px dashed #3b82f6; background: rgba(59, 130, 246, 0.1); pointer-events:none;"></div>
            </svg>

            <!-- Floating Snip Preview Layer -->
            <img id="snip-preview" class="hidden fixed pointer-events-none z-[9999] opacity-80 border-2 border-blue-500 border-dashed shadow-xl object-contain bg-white">

            <!-- AI Sidebar -->
            <aside id="ai-sidebar" class="bg-white border-l border-gray-200 flex flex-col shrink-0 z-20 relative overflow-hidden">
                <!-- Header -->
                <div class="h-12 border-b border-gray-200 flex items-center justify-between px-4 bg-gray-50 shrink-0 relative z-40 shadow-sm">
                    <div class="flex items-center gap-2">
                        <button onclick="toggleChatHistory()" class="text-gray-500 hover:text-blue-600 transition-colors w-6 h-6 flex items-center justify-center rounded hover:bg-gray-200" title="Chat History">
                            <i class="fa-solid fa-bars-staggered"></i>
                        </button>
                        <i class="fa-solid fa-robot text-blue-600"></i>
                        <span class="text-sm font-bold text-gray-700">AI Assistant</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <button onclick="createNewChat()" class="text-gray-400 hover:text-blue-600 transition-colors" title="New Chat">
                            <i class="fa-solid fa-plus"></i>
                        </button>
                        <!-- AI Settings Button -->
                        <button onclick="openAiSettings()" class="text-gray-400 hover:text-blue-600 transition-colors" title="AI Settings">
                            <i class="fa-solid fa-gear"></i>
                        </button>
                    </div>
                </div>

                <!-- Chat History Drawer (Overlay) -->
                <div id="chat-history-drawer" class="absolute top-12 left-0 w-full bottom-0 bg-white shadow-xl transform -translate-x-full transition-transform duration-300 z-30 flex flex-col border-r border-gray-200">
                    <div class="p-3 bg-gray-50 border-b border-gray-100 flex justify-between items-center shrink-0">
                        <span class="text-xs font-bold text-gray-600 uppercase tracking-wider">Chat History</span>
                        <div class="flex gap-2">
                            <button onclick="toggleChatHistory()" class="text-gray-400 hover:text-gray-600 px-2 py-1 transition-colors" title="Close">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>
                    <div id="chat-list" class="flex-1 overflow-y-auto bg-gray-50/50">
                        <!-- Chat items injected here -->
                    </div>
                </div>

                <!-- Chat Area (Middle) -->
                <div id="chat-history" class="p-4 space-y-4 bg-white overflow-y-auto flex-1 z-10 relative">
                    <div class="text-center text-xs text-gray-400 mt-4">
                        Ask a question about the loaded PDFs.
                        <br>Uses <span class="font-mono">nomic-embed-text</span> & local LLM.
                    </div>
                </div>

                <!-- Input Area (Bottom) -->
                <div class="p-3 border-t border-gray-200 bg-gray-50 shrink-0">
                    <div class="relative">
                        <textarea id="chat-input" rows="2" class="w-full p-2 pr-10 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none" placeholder="Ask about this document..."></textarea>
                        <button id="send-chat-btn" class="absolute bottom-2 right-2 p-1.5 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                            <i class="fa-solid fa-paper-plane text-xs"></i>
                        </button>
                    </div>
                    <div id="ai-status" class="text-[10px] text-gray-500 mt-1 h-4"></div>
                </div>
            </aside>

        </main>
    </div>

    <div id="tool-cursor" class="hidden fixed pointer-events-none z-[100] flex items-center justify-center">
        <i id="tool-cursor-icon" class="fa-thin fa-pen"></i>
    </div>

    <!-- Alert Modal -->
    <div id="modal" class="fixed inset-0 modal-backdrop hidden flex items-center justify-center z-[9999]">
        <div class="bg-white rounded-lg shadow-xl p-6 max-w-sm w-full">
            <h3 id="modal-title" class="text-lg font-bold mb-2">Alert</h3>
            <div id="modal-body-container" class="mb-4">
                <p id="modal-body" class="text-gray-600 mb-4">Message</p>
                <input type="text" id="modal-input" class="hidden w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex justify-end gap-2" id="modal-actions">
                <button onclick="closeModal(false)" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded text-sm">Cancel</button>
                <button onclick="closeModal(true)" id="modal-confirm-btn" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm">Confirm</button>
            </div>
        </div>
    </div>

    <!-- AI Settings Modal -->
    <div id="ai-settings-modal" class="fixed inset-0 modal-backdrop hidden flex items-center justify-center z-[9999]">
        <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-gray-800"><i class="fa-solid fa-robot mr-2 text-blue-600"></i>AI Configuration</h3>
                <button onclick="closeAiSettings()" class="text-gray-400 hover:text-red-500 transition-colors"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            
            <form id="ai-settings-form" class="space-y-4">
                <!-- 1. Model Selection -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Model Selection (Ollama API)</label>
                    <input type="text" id="ai-setting-model" class="w-full p-2 border border-gray-300 rounded text-sm focus:ring-2 focus:ring-blue-500" placeholder="e.g., gemma3:1b, llama3.2">
                </div>

                <!-- 2. System Prompt -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">System Prompt</label>
                    <textarea id="ai-setting-prompt" rows="3" class="w-full p-2 border border-gray-300 rounded text-sm focus:ring-2 focus:ring-blue-500"></textarea>
                </div>

                <!-- 3. Response Style -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Response Style</label>
                    <select id="ai-setting-style" class="w-full p-2 border border-gray-300 rounded text-sm focus:ring-2 focus:ring-blue-500">
                        <option value="Concise">Concise</option>
                        <option value="Detailed">Detailed</option>
                        <option value="Expert">Expert</option>
                    </select>
                </div>

                <!-- 4. Temperature -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1 flex justify-between">
                        <span>Temperature (Creativity)</span>
                        <span id="ai-setting-temp-val" class="font-mono text-blue-600">0.7</span>
                    </label>
                    <input type="range" id="ai-setting-temp" min="0" max="1" step="0.1" class="w-full accent-blue-600">
                </div>

                <!-- 5. Strict RAG -->
                <div class="flex items-center gap-2 mt-2">
                    <input type="checkbox" id="ai-setting-strict" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500">
                    <label class="text-sm font-medium text-gray-700">Strict RAG Mode (Limit to Context)</label>
                </div>

                <!-- 6. Include Chat History -->
                <div class="flex items-center gap-2 mt-2">
                    <input type="checkbox" id="ai-setting-history" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500">
                    <label class="text-sm font-medium text-gray-700">Include Chat History in Context</label>
                </div>

                <!-- 7. Skip LLM -->
                <div class="flex items-center gap-2 mt-2">
                    <input type="checkbox" id="ai-setting-skip-llm" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500">
                    <label class="text-sm font-medium text-gray-700">Skip LLM (Return Sources Only)</label>
                </div>

                <hr class="border-gray-200 my-2">

                <!-- 8. Similarity Threshold -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1 flex justify-between">
                        <span>Similarity Threshold</span>
                        <span id="ai-setting-sim-val" class="font-mono text-blue-600">0.65</span>
                    </label>
                    <input type="range" id="ai-setting-sim" min="0" max="1" step="0.05" class="w-full accent-blue-600">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <!-- 8. Context Budget -->
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Context Budget (Chars)</label>
                        <input type="number" id="ai-setting-budget" min="1000" max="32000" step="500" class="w-full p-2 border border-gray-300 rounded text-sm focus:ring-2 focus:ring-blue-500">
                    </div>

                    <!-- 9. Max Chunks -->
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Max Retrieved Chunks</label>
                        <input type="number" id="ai-setting-max-chunks" min="1" max="30" class="w-full p-2 border border-gray-300 rounded text-sm focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                
                <!-- 10. Chunk Size -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Vector Chunk Size (Chars)</label>
                    <input type="number" id="ai-setting-chunk-size" min="100" max="2000" step="100" class="w-full p-2 border border-gray-300 rounded text-sm focus:ring-2 focus:ring-blue-500">
                    <p class="text-[10px] text-orange-500 mt-1"><i class="fa-solid fa-triangle-exclamation"></i> Changing this forces a re-index of documents.</p>
                </div>

            </form>

            <div class="mt-6 flex justify-end gap-2 pt-2 border-t border-gray-200">
                <button onclick="resetAiSettings()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded text-sm transition-colors font-medium">Reset Defaults</button>
                <button onclick="saveAiSettings()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm shadow-sm transition-colors font-medium">Save Settings</button>
            </div>
        </div>
    </div>

    <!-- Move Dialog (used by filemanager.showMoveDialog) -->
    <div id="move-dialog" class="fixed inset-0 modal-backdrop hidden flex items-center justify-center z-[9999]">
        <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full max-h-[80vh] flex flex-col">
            <div class="flex justify-between items-center mb-3">
                <h3 class="text-base font-bold text-gray-800"><i class="fa-solid fa-folder-tree mr-2 text-blue-600"></i>Move to folder</h3>
                <button onclick="document.getElementById('move-dialog').classList.add('hidden')" class="text-gray-400 hover:text-red-500 transition-colors"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="text-xs text-gray-500 mb-2">Select a destination folder:</div>
            <div id="move-dialog-tree" class="border border-gray-200 rounded p-2 overflow-y-auto flex-1 bg-gray-50/30"></div>
            <div class="mt-4 flex justify-end gap-2">
                <button id="move-dialog-cancel" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded text-sm">Cancel</button>
                <button id="move-dialog-confirm" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm font-medium">Move here</button>
            </div>
        </div>
    </div>

    <script src="js/utils.js"></script>
    <script src="js/config.js"></script>
    <script src="js/api.js"></script>
    <script src="js/state.js"></script>
    <script src="js/database.js"></script>
    <script src="js/ui.js"></script>
    <script src="js/ai.js"></script>
    <script src="js/pdf.js"></script>
    <script src="js/search.js"></script>
    <script src="js/annotations.js"></script>
    <script src="js/links.js"></script>
    <!-- NEW: folder + file management modules -->
    <script src="js/folders.js"></script>
    <script src="js/filemanager.js"></script>
    <script src="js/events.js"></script>
    <script src="js/app.js"></script>

</body>
</html>